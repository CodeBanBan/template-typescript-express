{
  "name": "template-typescript-express",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "app/app.ts",
  "scripts": {
    "start": "NODE_ENV=development node_modules/.bin/nodemon scripts/api.ts",
    "start:ts": "ts-node scripts/api.ts",
    "lint:standard": "eslint '**/*.ts'",
    "lint:typescript": "tsc --noEmit",
    "lint": "npm run lint:standard && npm run lint:typescript",
    "test:prepare:mysql": "./tests/_prepare-test/prepare-mysql-container.sh",
    "test:prepare:redis": "./tests/_prepare-test/prepare-redis-container.sh",
    "test:prepare": "npm run test:prepare:mysql; npm run test:prepare:redis;",
    "test:start": "NODE_ENV=test ts-mocha -p tsconfig.json --exit",
    "test": "npm run test:prepare; npm run test:start",
    "build": "rm -rf _dist & tsc -p tsconfig.build.json",
    "task:hello:start": "NODE_ENV=development ts-node scripts/exec-task.ts hello-task",
    "runner:hello:start": "NODE_ENV=development ts-node scripts/runner-hello-task.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "2.2.2",
    "cors": "2.8.6",
    "custom-env": "2.0.6",
    "express": "5.2.1",
    "http-status": "2.1.0",
    "ioredis": "5.9.3",
    "lodash": "4.17.23",
    "mysql2": "3.17.1",
    "pino": "10.3.1",
    "sequelize": "6.37.7"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ioredis": "5.0.0",
    "@types/lodash": "4.17.23",
    "@types/mocha": "10.0.10",
    "@types/node": "25.2.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.2.1",
    "globals": "17.3.0",
    "mocha": "11.7.5",
    "neostandard": "0.12.2",
    "nodemon": "3.1.11",
    "supertest": "7.2.2",
    "ts-mocha": "11.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
